<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- iOS 黄色文件夹图标 -->
    <ImageView
        android:id="@+id/ivFolderIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_pencil_square"
        app:tint="@color/ios_yellow" />

    <!-- 文件夹名称 -->
    <TextView
        android:id="@+id/tvFolderName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:text="@string/notes_default"
        android:textColor="@color/ios_text_primary"
        android:textSize="17sp" />

    <!-- 备忘录计数 -->
    <TextView
        android:id="@+id/tvFolderCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="12"
        android:textColor="@color/ios_text_secondary"
        android:textSize="17sp" />

    <!-- iOS 经典右侧灰箭头 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/ios_text_tertiary"
        android:textSize="20sp" />
</LinearLayout>
